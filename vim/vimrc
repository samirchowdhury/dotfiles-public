runtime! defaults.vim
filetype plugin indent on
syntax enable

set number
set relativenumber
set termguicolors
set background=dark
packadd! rose-pine
colorscheme rosepine_moon

nnoremap <silent> <C-f> :BLines<CR>

let g:ale_linters_explicit = 1
let g:ale_linters = {'markdown': ['markdownlint_cli2']}

function! s:FormatMarkdown() abort
  let l:command = 'cd ' . shellescape(expand('%:p:h')) . ' && markdownlint-cli2 --format'
  let l:lines = systemlist(l:command, getline(1, '$'))
  if v:shell_error
    throw 'Markdown formatting failed: ' . join(l:lines, "\n")
  endif
  if empty(l:lines)
    let l:lines = ['']
  endif
  if l:lines ==# getline(1, '$')
    return
  endif
  let l:view = winsaveview()
  call setline(1, l:lines)
  if line('$') > len(l:lines)
    undojoin
    call deletebufline(bufnr(''), len(l:lines) + 1, '$')
  endif
  call winrestview(l:view)
endfunction

augroup markdown_formatting
  autocmd!
  autocmd BufWritePre * if &l:filetype ==# 'markdown' | call s:FormatMarkdown() | endif
augroup END
